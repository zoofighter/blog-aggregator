# 블로그 애그리게이터 환경 변수 설정 예시
# 이 파일을 복사해서 .env로 만들고 실제 값을 입력하세요

# 데이터베이스 타입 (sqlite 또는 postgresql)
DB_TYPE=sqlite

# PostgreSQL 설정 (DB_TYPE=postgresql일 때만 사용)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blog_aggregator
DB_USER=postgres
DB_PASSWORD=

# SQLite 설정 (DB_TYPE=sqlite일 때만 사용)
DB_PATH=blogs.db

# 사용 예시:
#
# === SQLite 사용 (기본) ===
# DB_TYPE=sqlite
# DB_PATH=blogs.db
#
# === PostgreSQL 사용 (비밀번호 없음) ===
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=blog_aggregator
# DB_USER=postgres
# DB_PASSWORD=
#
# === PostgreSQL 사용 (비밀번호 있음) ===
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=blog_aggregator
# DB_USER=postgres
# DB_PASSWORD=MySecure123!
#
# === Docker PostgreSQL ===
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=blog_aggregator
# DB_USER=postgres
# DB_PASSWORD=mysecret123
